# Agora Conversational AI — see docs/AGORA_INTEGRATION.md for the verified
# API contract this config wires up to.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# REST API (Conversational AI Engine) auth — a separate Customer ID/Secret
# pair from the app_id/app_certificate above (Console -> RESTful API).
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=
AGORA_REST_BASE_URL=https://api.agora.io/api/conversational-ai-agent/v2
# HMAC secret Agora signs webhook callbacks with (Console -> Notifications).
AGORA_WEBHOOK_SECRET=

# LLM (structured extraction only — never owns application state)
# LLM_PROVIDER selects which client app/services/llm_factory.py builds:
# "anthropic" (default) or "gemini" (free-tier-friendly for local dev —
# see docs/GEMINI_PROVIDER.md before relying on it against the real API).
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Slack (real integration — gated by human approval)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Persistence (MVP runs in-memory; set this when the SQLite/Postgres
# repository implementation lands)
DATABASE_URL=

LOG_LEVEL=INFO
